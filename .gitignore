# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg
.installed.cfg
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Packaging / tooling caches ---
.uv/
uv.lock          # tracked deliberately? keep uncommented to ignore the lock during scaffold phase
.tox/
.nox/
.cache/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Jupyter / notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Data: do NOT commit ALEdb pulls or GSM dumps ---
# ALEdb bulk-export licensing is unverified (see README "Data" section); ship a
# fetch script, never the corpus. Large model/feature artifacts stay out too.
data/
!data/.gitkeep
!data/HOWTO_PULL.md
!data/HOWTO_SEQUENCE_FEATURES.md
!data/model_gene_uniprot.csv   # public E. coli b-number->UniProt map; ESM scripts depend on it (no cobra needed)
features/cache/
models/artifacts/
*.sqlite
*.sqlite3
*.db
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.joblib
*.npz

# --- GSM / SBML scratch (BiGG pulls are re-fetchable; keep them out of git) ---
*.xml.gz
*_scratch.sbml

# --- Reports / rendered figures ---
report/*.pdf
report/build/
figures/*.png
!figures/fig*.png
figures/*.pdf
!figures/.gitkeep

# --- OS / editor cruft ---
.DS_S
report/_robustness_raw*.json

# ship the E. coli flux-feature cache so the fusion scripts run without a solver
!features/feature_matrix.parquet
